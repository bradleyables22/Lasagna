<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <IsPackable>true</IsPackable>
    <ToolCommandName>lasagna</ToolCommandName>
    <PackageId>Lasagna</PackageId>
    <Version>0.0.9-beta</Version>
    <Authors>Bradley Ables</Authors>
    <Description>Save and reuse individual files and file bundles in .NET projects.</Description>
    <PackageProjectUrl>https://github.com/bradleyables22/Lasagna</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bradleyables22/Lasagna.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet-tool;dotnet;files;bundles;scaffolding</PackageTags>
    <PackageIcon>lasagna-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="" />
    <None Update="LICENSE" Pack="true" PackagePath="" />
    <None Remove="Server\wwwroot\**" />
    <Content Include="Server\wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="tools\net10.0\any" />
    <None Include="Server\wwwroot\images\lasagna-icon.png" Pack="true" PackagePath="" TargetPath="lasagna-icon.png" />

  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HeimdallFramework.Server" Version="3.1.0" />
    <PackageReference Include="HeimdallFramework.Web" Version="3.1.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>

</Project>
