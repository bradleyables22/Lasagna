<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lasagna</ToolCommandName>
    <PackageId>Lasagna</PackageId>
    <Version>0.0.2-beta</Version>
    <Authors>Lasagna contributors</Authors>
    <Description>Save and reuse individual files and file bundles in .NET projects.</Description>
    <PackageTags>dotnet-tool;dotnet;files;bundles;scaffolding</PackageTags>
    <PackageIcon>lasagna-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Update="lasagna-icon.png" Pack="true" PackagePath="" />
    <None Update="README.md" Pack="true" PackagePath="" />
    <None Update="LICENSE" Pack="true" PackagePath="" />
    <EmbeddedResource Include="lasagna-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.ImageSharp" Version="0.57.2" />
  </ItemGroup>

</Project>
